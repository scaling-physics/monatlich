<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- A single cat-shaped piggy bank: sitting cat silhouette (haunches, head, ears, curled tail,
         two front paws) with a coin slot cut into the top of its head. One cohesive object rather
         than two separate ones, built from bold blob + round-cap-stroke shapes so it stays
         legible at launcher size. -->

    <!-- Body and head. -->
    <path android:fillColor="#FFF3EE" android:pathData="M35,64 A19,17 0 1,0 73,64 A19,17 0 1,0 35,64 Z" />
    <path android:fillColor="#FFF3EE" android:pathData="M40,40 A14,14 0 1,0 68,40 A14,14 0 1,0 40,40 Z" />

    <!-- Ears. -->
    <path android:fillColor="#FFF3EE" android:pathData="M42,30 L46,18 L53,29 Z" />
    <path android:fillColor="#FFF3EE" android:pathData="M55,29 L62,18 L66,30 Z" />

    <!-- Front paws. -->
    <path
        android:pathData="M45,79 L45,87"
        android:strokeColor="#FFF3EE"
        android:strokeWidth="7"
        android:strokeLineCap="round" />
    <path
        android:pathData="M63,79 L63,87"
        android:strokeColor="#FFF3EE"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- Curled tail, sweeping from the body's side around to the front. -->
    <path
        android:pathData="M72,64 Q85,72 72,82 Q61,88 57,79"
        android:strokeColor="#FFF3EE"
        android:strokeWidth="9"
        android:strokeLineCap="round" />

    <!-- Coin slot and eyes, cut into the head with the background colour. -->
    <path
        android:pathData="M47,31 L61,31"
        android:strokeColor="#6B1F2A"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />
    <path android:fillColor="#6B1F2A" android:pathData="M44.4,41 A1.6,1.6 0 1,0 47.6,41 A1.6,1.6 0 1,0 44.4,41 Z" />
    <path android:fillColor="#6B1F2A" android:pathData="M60.4,41 A1.6,1.6 0 1,0 63.6,41 A1.6,1.6 0 1,0 60.4,41 Z" />
</vector>
